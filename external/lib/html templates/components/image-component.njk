
<div name="{{ element.id }}" class="acr-fragment acr-component image-container {%- if element.mobile_only %}is-mobile-visible is-desktop-hidden {% elif element.desktop_only %} is-mobile-hidden is-desktop-visible {% endif -%}"
data-component-id="image"
style="width:100%;text-align:{{ element.align or "center" }}; background-color: {{ element.background or "transparent"}};"
data-has-int-mso-hack="true"
contenteditable="false">
