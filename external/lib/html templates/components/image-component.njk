{%-if element.content.href-%}
<a class="arc-link aers-clickable" data-nl-type="externalLink" href="{{ element.content.href }}" style="text-decoration: underline;" data-label="{{ element.name }}" data-tracking-type="TRACKED" data-tags="" >
{%-endif-%}
<img width="{%-if element.width-%}{{ element.width.replace("px", "") }}{%-else-%}100%{%-endif-%}" style="height: auto;max-width: {{ element.max_width or "100%" }}; width: {{ element.width }};border-radius:{{ element.border_radius }}; " class="" src="{{ element.content.src }}" height="auto"
data-medialibrary-id="{{ element.content.aem_id or "urn:aaid:aem:5d5850a0-4cfc-44e4-b386-ff90923db667"}}" data-mediarepo-id="author-p152614-e1584203.adobeaemcloud.com"
data-medialibrary-source="aem" />
{%-if element.content.href-%}
</a>
{%-endif-%}
