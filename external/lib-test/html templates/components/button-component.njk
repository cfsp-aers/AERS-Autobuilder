{%-if element.mode == "underline" %}strokecolor=""{%-else-%}strokecolor="{{ element.border_bottom or element.background }}"{%-endif-%}
><v:stroke {%-if element.mode == "underline" %} opacity="0"{% else %} opacity="100%"{%-endif-%}/>
<v:textbox inset="0,0,0,0"><center style="color: {{ element.colour }}; font-family:'{{ element.font }}', Arial, sans-serif;font-size: {{ element.font_size }}; line-height: {{ element.line_height }}; {%if element.mode == "underline" or element.mode == "outline" %}margin: 0px 8px; {% else %}margin: 0px 16px; {% endif-%}
text-align:center;
"><![endif]-->
