{%-if element.border_top -%}border-top: {{ element.border_weight }} solid {{ element.border_top }}; {% else-%}border-top: {{ element.border_weight }} solid {{ element.background }}; {% endif-%}
{%-if element.border_right -%}border-right: {{ element.border_weight }} solid {{ element.border_right }}; {% else-%}border-right: {{ element.border_weight }} solid {{ element.background }}; {% endif-%}
{%-if element.border_bottom -%}border-bottom: {{ element.border_weight }} solid {{ element.border_bottom }}; {% else-%}border-bottom: {{ element.border_weight }} solid {{ element.background }}; {% endif-%}
{%-if element.border_left -%}border-left: {{ element.border_weight }} solid {{ element.border_left }}; {% else-%}border-left: {{ element.border_weight }} solid {{ element.background }}; {% endif-%}
border-image: initial;border-radius: {{ element.border_radius }}; height: {{ element.height }}; {%-if element.height != "auto" -%}line-height: {{ element.height }};{%-endif-%} padding: {{ element.inner_padding }}; {%if element.background %}background-color: {{ element.background }}; {% endif-%}
" contenteditable="true">
<span contenteditable="true" style="
{%-if element.force_mso_colour -%}{%-else-%}mso-color-alt: auto; {% endif-%}
color: {{ element.colour }}; font-size: {{ element.font_size }}; line-height: {{ element.line_height }}; {%if element.font_weight -%}font-weight: {{ element.font_weight }}; {% endif-%}
font-style: {{ element.font_style }}; text-decoration: none;">
{{-element.content.text }}
</span></div>
